<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>My Blog</title>

  <style>
    body {
      font-family: Arial, sans-serif;
      max-width: 900px;
      margin: 50px auto;
      padding: 20px;
      background: #f5f5f5;
    }

    h1 {
      color: #333;
    }

    .post {
      background: white;
      padding: 20px;
      margin-bottom: 20px;
      border-radius: 8px;
    }

    .post h2 {
      margin-top: 0;
    }

    .post a {
      color: #2563eb;
      text-decoration: none;
    }
  </style>
</head>

<body>

  <h1>My Blog</h1>

  <% if (posts.length === 0) { %>

    <p>No posts available.</p>

  <% } else { %>

    <% posts.forEach(post => { %>

      <div class="post">

        <h2><%= post.title %></h2>

        <p><%= post.content %></p>

        <a href="/posts/<%= post.id %>">
          Read more
        </a>

      </div>

    <% }) %>

  <% } %>

</body>
</html>