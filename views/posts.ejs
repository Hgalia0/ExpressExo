
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>All Posts</title>
  <link rel="stylesheet" href="/style.css">
</head>
<body>
  <nav>
    <a href="/">Home</a>
    <a href="/posts">All Posts</a>
  </nav>

  <main>
    <div class="page-header">
  <div>
    <h1>All Posts</h1>
    <p>Your collection of stories and ideas.</p>
  </div>

  <a href="/posts/new" class="add-post-btn">
    + Add a Post
  </a>
</div>

    <% if (posts.length === 0) { %>
      <p>No posts yet.</p>
    <% } %>

    <% posts.forEach(post => { %>
      <article>
        <h2><%= post.title %></h2>
        <p><%= post.content %></p>

        <a href="/posts/<%= post._id %>">Read</a>
        <a href="/posts/<%= post._id %>/edit">Edit</a>

        <form action="/posts/<%= post._id %>/delete" method="POST">
          <button type="submit">Delete</button>
        </form>
      </article>
      <hr>
    <% }) %>
  </main>
</body>
</html>
