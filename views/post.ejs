<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= post.title %></title>

  <style>
    body {
      font-family: Arial, sans-serif;
      max-width: 900px;
      margin: 50px auto;
      padding: 20px;
      background: #f5f5f5;
    }

    .post {
      background: white;
      padding: 30px;
      border-radius: 8px;
    }

    a {
      color: #2563eb;
      text-decoration: none;
    }
  </style>
</head>

<body>

  <div class="post">

    <h1><%= post.title %></h1>

    <p><%= post.content %></p>

    <a href="/posts">
      ← Back to all posts
    </a>

  </div>

</body>
</html>